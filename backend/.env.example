# Application
APP_NAME=SME Management
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sme_management

# JWT
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# PayPal (optional)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Peppol (optional)
PEPPOL_ENABLED=false
PEPPOL_PARTICIPANT_ID=
PEPPOL_API_URL=
PEPPOL_API_KEY=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true

# Defaults
DEFAULT_CURRENCY=EUR
DEFAULT_VAT_RATE=21.0
DEFAULT_PAYMENT_TERMS=30
